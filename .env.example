# ============================================================

# REQUIRED

# ============================================================



# Get your Slimefish CLOB Auth credentials by connecting your EVM wallet (Polygon, 0x...) at https://auth.kuest.com

KUEST_ADDRESS=""

KUEST_API_KEY=""

KUEST_API_SECRET=""

KUEST_PASSPHRASE=""



# Admin wallets (comma-separated, EVM 0x... addresses on Polygon)

ADMIN_WALLETS=""



# Public site URL, used for canonical links, wallet metadata, embeds, and callbacks

SITE_URL=""



# Your REOWN APPKIT project id http://dashboard.reown.com/

REOWN_APPKIT_PROJECT_ID=""



# Random 32 characters – generate one on "generate secret" button https://www.better-auth.com/docs/installation#set-environment-variables

# Changing this value will invalidate all user sessions AND encrypted credentials, requiring users to log in and re-authenticate for trading.

BETTER_AUTH_SECRET=""



# Vercel Cron Jobs (Create a random secret of at least 16 characters)

CRON_SECRET=""



# ============================================================

# OPTIONAL

# ============================================================



# Disable Next.js image optimization

DISABLE_IMAGE_OPTIMIZATION=false



# Optional RPC endpoint used for on-chain reads in the app

POLYGON_RPC_URL=""



# Active chain id exposed through the runtime config script.

# Leave empty/80002 for Amoy; set 137 for Polygon mainnet.

CHAIN_ID=""



# Force public shell prerendering on/off at runtime.

# Leave empty to infer from SITE_URL/VERCEL_PROJECT_PRODUCTION_URL + POSTGRES_URL + REOWN_APPKIT_PROJECT_ID.

BUILD_PRERENDER_PUBLIC_SHELL=""



# PostgreSQL runtime connection (required outside Vercel/Supabase integration flow)
POSTGRES_URL="postgresql://postgres:postgres@localhost:5434/tellwise"
SLIMEFISH_BACKEND_POSTGRES_URL="postgresql://postgres:postgres@localhost:5434/slimefishbackend"



# Supabase credentials (optional outside Supabase mode; if one is set, both are required)

SUPABASE_URL="https://rrvlcjmysgslqzyatvzl.supabase.co"

SUPABASE_SERVICE_ROLE_KEY=""



# S3-compatible storage (required when SUPABASE_* is not configured)

S3_BUCKET=""

S3_ENDPOINT=""

S3_REGION=""

S3_ACCESS_KEY_ID=""

S3_SECRET_ACCESS_KEY=""

S3_PUBLIC_URL=""

S3_FORCE_PATH_STYLE=true



# Sentry monitoring https://sentry.io/

SENTRY_DSN=""

SENTRY_ORG=""

SENTRY_PROJECT=""

SENTRY_AUTH_TOKEN=""



# Private keys used to sign recurring event creations

# Format: comma-separated list of private keys no spaces (eg. key1,key2,key3)

EVENT_CREATION_SIGNER_PRIVATE_KEYS=



# Mock mode for local testing without external API keys
NEXT_PUBLIC_MOCK_MODE=false
NEXT_PUBLIC_LOCAL_MATCHING=false
NEXT_PUBLIC_TELLWISE_LOCAL_LOGIN=false
TELLWISE_LOCAL_USERNAME=""

# Tellwise-owned service boundaries. Set these when NEXT_PUBLIC_LOCAL_MATCHING=false.
TELLWISE_CLOB_URL=""
TELLWISE_DATA_URL=""
TELLWISE_GAMMA_URL=""
TELLWISE_RELAYER_URL=""
TELLWISE_USER_PNL_URL=""
TELLWISE_PRICE_REFERENCE_URL=""
TELLWISE_WS_CLOB_URL=""
TELLWISE_WS_LIVE_DATA_URL=""
TELLWISE_COMMUNITY_URL=""
TELLWISE_CREATE_MARKET_URL=""
TELLWISE_GEOBLOCK_URL=""
TELLWISE_SDK_DOWNLOAD_URL=""

# M-Pesa/mobile-money to USDC ramp integration.
TELLWISE_RAMP_PROVIDER="sandbox"
TELLWISE_RAMP_API_URL=""
TELLWISE_RAMP_API_KEY=""
TELLWISE_RAMP_SETTLEMENT_CHAIN="base"
TELLWISE_KES_PER_USDC="129"
TELLWISE_RAMP_FEE_BPS="150"

# Internal settlement and background processing. Generate separate random values
# per environment and store production values in the hosting secret manager.
SETTLEMENT_ADAPTER="slimefish_backend"
SLIMEFISH_BACKEND_SERVICE_API_KEY=""
SLIMEFISH_BACKEND_REQUEST_PRIVATE_KEY=""
SLIMEFISH_ALLOWED_SERVICE_ORIGINS="https://slimefish.com,https://www.slimefish.com,https://api.slimefish.com"
SLIMEFISH_FRONTEND_URL="https://slimefish.com"
JOB_RUNNER_SECRET=""

# Optional exact-match aliases until a licensed screening provider is connected.
# Example: [{"name":"Example Name","aliases":["Example Alias"]}]
SANCTIONS_WATCHLIST_JSON="[]"


# Admin verification for Reown authentication

ADMIN_VERIFICATION_EMAIL=""

ADMIN_VERIFICATION_PASSPHRASE=""

